{
  "name": "astarray-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Single-agent task kernel for Astarray Lite",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

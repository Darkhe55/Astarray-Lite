{
  "name": "astarray-lite",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Single-agent task kernel for Astarray Lite",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "astarray-lite": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:pack": "node scripts/verify-package.mjs",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "soak": "node scripts/soak.mjs",
    "soak:live": "node scripts/soak-live.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:pack"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
